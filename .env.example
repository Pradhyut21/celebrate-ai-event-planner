# Copy to .env. The application works without an API key using explicit local rules.
PORT=3001
HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required in production when OPENAI_API_KEY is set. Use a long random value.
# Enter this value in the app's session-only AI access field.
PLANNER_ACCESS_TOKEN=
# Exact browser origin for a hosted deployment; do not use wildcard origins.
# APP_ORIGIN=https://your-planner.example

