{
  "name": "celebrate-ai-event-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible GenAI planning assistant for weddings, birthdays and community events.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:size": "node scripts/check-repository.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:size"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
